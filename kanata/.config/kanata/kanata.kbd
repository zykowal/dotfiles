;; Kanata docs
;; https://github.com/jtroo/kanata/blob/main/docs/config.adoc

;; OS key code mappings
;; https://github.com/jtroo/kanata/blob/main/parser/src/keys/mod.rs

(defvar
 tap-time 100
 hold-time 120
)

(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  danger-enable-cmd yes
  concurrent-tap-hold yes

  ;; When any non-chord activation happens, this timeout begins. Until this timeout expires
  ;; all inputs will immediately skip chords processing and be processed by the active layer.
  ;; chords-v2-min-idle 250
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer qwerty
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @num q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap @a   @s   d    @f   g    h    j    k    l    @;   '    ret
  lsft z    x    c    v    b    n    m    @nav .    /    rsft
  lctl lmet lalt           @sym           ralt rmet rctl
)

(deftemplate charmod (timeouthold char mod)
  (switch
    ((key-timing 3 less-than 140)) $char break
    () (tap-hold-release 0 $timeouthold $char $mod) break
  )
)

(defalias
  num (t! charmod $hold-time tab (layer-while-held numbers))
  nav (t! charmod $hold-time , (layer-while-held navigation))
  sym (t! charmod $hold-time spc (layer-while-held symbols))
  fun (t! charmod $hold-time tab (layer-while-held function))

  cap (t! charmod $hold-time esc lctl)

  a (t! charmod 140 a lctl)
  s (t! charmod $hold-time s lalt)
  f (t! charmod $hold-time f lsft)
  ; (t! charmod $hold-time ; rsft)
)

;; Function keys layer - F keys and special keys
(deflayer function
  _   _      _    _    _    _    _    _    _    _    _    _    _    _
  _   voldwn volu mute _    _    _    f7   f8   f9   f10  _    _    _
  _   _      _    _    _    _    _    f4   f5   f6   f11  _    _
  _   _      _    _    _    _    _    f1   f2   f3   f12  _
  _   _      _              _              _    _    _
)

;; Numbers layer - left hand number pad
(deflayer numbers
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    7    8    9    0    _    _    _
  _    _    _    _    _    _    _    4    5    6    _    _    _
  _    _    _    _    _    _    _    1    2    3    _    _
  _    _    _              _              _    _    _
)

;; Symbols layer - shifted versions of numbers layer
(deflayer symbols
  _    _    _     _    _    _    _     _    _     _    _    _    _    _
  @fun grv  S-grv S-9  S-0  [    ]     S-[  S-]   S-'  '    _    _    _
  _    S-2  S-4   S-8  S-7  S-\  bspc  -    S--   =    +    _    _
  _    S-5  S-6   S-1  S-3  \    C-S-v ret  lsft  _    _    _
  _    _    _               _               _     _    _
)

;; Navigation layer
(deflayer navigation
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    up   _    _    _    _    _    _    _    _    _    _    _
  _    left down rght _    _    _    _    _    _    _    _    _
  _    home pgup pgdn end  _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)
